{
  "name": "bust-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "scripts": {
    "preinstall": "npx --yes only-allow npm",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src public/sw.js",
    "lint:functions": "deno lint --config supabase/functions/deno.json supabase/functions",
    "typecheck:functions": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "material-symbols": "^0.35.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
