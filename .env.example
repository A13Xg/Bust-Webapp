DATABASE_URL=postgresql://user:pass@host:5432/postgres
JWT_SECRET=change-me
PORT=8787

# Static (GitHub Pages) mode — set at build time:
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Web push. Generate a pair with:  npx web-push generate-vapid-keys
# The PUBLIC key must be exposed to the browser build as VITE_WEB_PUSH_PUBLIC_KEY;
# without it the app silently refuses to create push subscriptions.
VITE_WEB_PUSH_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY

# Supabase Edge Function secrets (never exposed to the browser):
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... REMINDER_CRON_SECRET=...
# VAPID_PUBLIC_KEY must be byte-identical to VITE_WEB_PUSH_PUBLIC_KEY, or every
# push is signed with a key the subscription was not created for and is dropped.
VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
REMINDER_CRON_SECRET=long-random-string

# Discord webhook notifications (optional). Mirrors every bust and every
# achievement into a Discord channel; idle/inactivity reminders never go to
# Discord. Fully admin-configurable at runtime from the debug menu's DISCORD
# tab (enable switches, templates, colors, mentions) — see
# src/discordTemplate.js and supabase/functions/_shared/discord.ts.
#
# Create an incoming webhook in Discord: Server Settings → Integrations →
# Webhooks → New Webhook, then copy its URL.
#
#   supabase secrets set DISCORD_WEBHOOK_URL=... SITE_URL=...
#
# DISCORD_WEBHOOK_URL is the fallback used when the admin has not set an
# override in the DISCORD tab; the integration stays off either way until an
# admin flips the "Discord integration enabled" switch there. Also settable as
# a GitHub Actions / repository secret and passed through to
# `supabase secrets set` in CI, the same way the other Edge Function secrets
# above are.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR-WEBHOOK-ID/YOUR-WEBHOOK-TOKEN
# Public URL this app is deployed at — used to build absolute links to the
# achievement tier badge sprites (public/badges/512/*.png) that ship inside
# Discord embeds. Defaults to the GitHub Pages URL in PROJECT.md if unset.
SITE_URL=https://a13xg.github.io/Bust-Webapp
